{
  "openapi": "3.0.0",
  "info": {
    "title": "Expense Management System API",
    "description": "REST API for managing personal expenses, built with Laravel and Sanctum authentication.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:8000/api" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Expense": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "date": { "type": "string", "format": "date", "example": "2026-08-20" },
          "cost_gbp": { "type": "number", "format": "decimal", "example": 45.50 },
          "description": { "type": "string", "example": "Taxi to client meeting" },
          "expense_type": { "type": "string", "enum": ["travel", "food", "other"] },
          "user_id": { "type": "integer", "example": 2 }
        }
      }
    }
  },
  "paths": {
    "/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "password_confirmation": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully, returns user and token" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Log in an existing user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns user and token" },
          "422": { "description": "Invalid credentials" }
        }
      }
    },
    "/expenses": {
      "get": {
        "summary": "List all expenses for the logged-in user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "A list of expenses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Expense" }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated" }
        }
      },
      "post": {
        "summary": "Create a new expense",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "date": { "type": "string", "format": "date" },
                  "cost_gbp": { "type": "number" },
                  "description": { "type": "string" },
                  "expense_type": { "type": "string", "enum": ["travel", "food", "other"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Expense created" },
          "422": { "description": "Validation error" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/expenses/{id}": {
      "get": {
        "summary": "View a single expense (owner only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Expense details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "403": { "description": "Forbidden - not the owner" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update an expense (owner only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Expense updated" },
          "403": { "description": "Forbidden - not the owner" },
          "422": { "description": "Validation error" }
        }
      },
      "delete": {
        "summary": "Delete an expense (owner only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Expense deleted" },
          "403": { "description": "Forbidden - not the owner" }
        }
      }
    }
  }
}
